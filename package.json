{
  "name": "jev-lens-monorepo",
  "private": true,
  "version": "0.5.0",
  "description": "jev picks what the model gets to see of large tool results. Core library, pi extension and Claude Code plugin.",
  "author": "Didrik Rognstad",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/pi-jev-lens",
    "packages/claude-code"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspace jev-lens",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/claude-code/tsconfig.json",
    "replay": "node --import tsx eval/replay.ts",
    "presend-replay": "node --import tsx eval/presend-replay.ts",
    "bench": "node --import tsx eval/bench/run.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typebox": "^1.3.33",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
