{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Read|Bash|Grep)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hook.ts\"",
            "timeout": 40,
            "statusMessage": "jev-lens is choosing a view"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${JEV_LENS_DATA_DIR:-${CLAUDE_PLUGIN_DATA:-$HOME/.claude/jev-lens}}\"; mkdir -p \"$d\" && cat >> \"$d/events.jsonl\"",
            "timeout": 5
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${JEV_LENS_DATA_DIR:-${CLAUDE_PLUGIN_DATA:-$HOME/.claude/jev-lens}}\"; mkdir -p \"$d\" && cat >> \"$d/events.jsonl\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
