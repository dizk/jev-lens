{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "eval/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "test/samples/**",
    "node_modules",
    "eval/runs/**",
    "eval/fixture/**"
  ]
}