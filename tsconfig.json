{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "jev-lens": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/core/test/**/*.ts",
    "packages/pi/index.ts",
    "packages/pi/src/**/*.ts",
    "packages/pi/test/**/*.ts",
    "eval/**/*.ts"
  ],
  "exclude": [
    "packages/core/test/samples/**",
    "node_modules",
    "eval/runs/**",
    "eval/fixture/**"
  ]
}
